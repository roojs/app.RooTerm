<node>
  <interface name="org.roojs.RooTerm.Shell">
    <method name="register">
      <arg type="s" name="role" direction="in"/>
      <arg type="s" name="handle" direction="in"/>
    </method>
    <method name="show">
      <arg type="s" name="role" direction="in"/>
    </method>
    <method name="hide">
      <arg type="s" name="role" direction="in"/>
    </method>
    <method name="toggle">
      <arg type="s" name="role" direction="in"/>
    </method>
    <method name="exited">
      <arg type="s" name="app_id" direction="in"/>
    </method>
  </interface>
</node>
